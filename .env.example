# Gunakan proxy Vite agar aplikasi dapat diakses dari komputer maupun HP.
VITE_API_BASE_URL=/api
# Kosongkan untuk development (asset lewat proxy frontend); isi jika host asset berbeda.
VITE_ASSET_BASE_URL=

# Backend lokal (SQLite)
API_PORT=8000
DATABASE_PATH=./storage/upelkes.sqlite
AUTH_REQUIRED=true
ADMIN_EMAIL=admin@upelkes.local
ADMIN_PASSWORD=ganti-password-awal-ini
# Set saat autentikasi diaktifkan untuk endpoint tulis.
AUTH_SECRET=ganti-dengan-secret-acak-yang-aman
