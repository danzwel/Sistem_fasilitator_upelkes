# Isi URL API bersama setelah backend tersedia.
VITE_API_BASE_URL=http://localhost:8000/api
# Kosongkan untuk development (asset lewat proxy frontend); isi jika host asset berbeda.
VITE_ASSET_BASE_URL=

# Backend lokal (SQLite)
API_PORT=8000
DATABASE_PATH=./storage/upelkes.sqlite
AUTH_REQUIRED=false
# Set saat autentikasi diaktifkan untuk endpoint tulis.
AUTH_SECRET=ganti-dengan-secret-yang-aman
